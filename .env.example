# Copy this file to .env.local. Both keys are OPTIONAL.
# Internship listings need NO key at all (free public SimplifyJobs feed).

# Recommended: free Gemini key for live CMU-research / REU / internship /
# hackathon discovery.
# Get one at https://aistudio.google.com/apikey — free tier, no credit card.
VITE_GEMINI_API_KEY=

# Optional fallback (paid): used only if the Gemini key is absent.
# https://platform.claude.com/
VITE_ANTHROPIC_API_KEY=
